# ──────────────────────────────────────────────────────────────────────────
# SarabCraft runtime environment (native / RunPod deployment)
# Copy to /workspace/sarab.env and fill in the secrets, then:
#     set -a; source /workspace/sarab.env; set +a
# Every value here matches what backend/jobs/core.py and the verifiers read.
# ──────────────────────────────────────────────────────────────────────────

# ── Where the app stores credentials/profiles (MUST be writable & persistent)
export SARABCRAFT_STATE_DIR=/var/lib/sarabcraft

# ── PostgreSQL (jobs/history/results) ──────────────────────────────────────
export POSTGRES_HOST=127.0.0.1
export POSTGRES_PORT=5432
export POSTGRES_DB=sarabcraft
export POSTGRES_USER=sarabcraft
export POSTGRES_PASSWORD=sarabcraft_pod_dev

# ── Redis (job queue / locks) ──────────────────────────────────────────────
export REDIS_URL=redis://127.0.0.1:6379/0

# ── MinIO (S3-compatible artifact store for adversarial outputs) ───────────
export S3_ENDPOINT_URL=http://127.0.0.1:9000
export ARTIFACT_BUCKET=sarabcraft-artifacts
export ARTIFACT_REGION=us-east-1
export ARTIFACT_ACCESS_KEY_ID=sarabcraft_minio
export ARTIFACT_SECRET_ACCESS_KEY=sarabcraft_minio_pod_dev
export ARTIFACT_FORCE_PATH_STYLE=true

# MinIO server credentials (must match ARTIFACT_* above)
export MINIO_ROOT_USER=sarabcraft_minio
export MINIO_ROOT_PASSWORD=sarabcraft_minio_pod_dev

# ── HuggingFace (optional: pulls gated/faster model downloads) ─────────────
export HF_HUB_DISABLE_TELEMETRY=1
export HF_API_TOKEN=

# ── AWS Rekognition / Transcribe (optional cloud verification) ─────────────
# Prefer adding these in the UI (Settings > Models), which persists them to
# profiles.json. These are only a fallback / convenience.
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_SESSION_TOKEN=
export AWS_DEFAULT_REGION=us-east-1
# png = always lossless | jpeg = always compressed | auto = PNG, fall back to JPEG if >5MB
export AWS_REKOGNITION_IMAGE_FORMAT=auto

# ── Other optional cloud verifiers ─────────────────────────────────────────
export AZURE_VISION_ENDPOINT=
export AZURE_VISION_KEY=
export GOOGLE_APPLICATION_CREDENTIALS=
export GCP_SERVICE_ACCOUNT_JSON=
export ELEVENLABS_API_KEY=

# ── Where the app listens (RunPod proxies port 8888) ───────────────────────
export SARAB_PORT=8888
export SARAB_REPO=/workspace/SarabCraft
export SARAB_VENV=/workspace/venv
export SARAB_LOG_DIR=/workspace
